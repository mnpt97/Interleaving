{
  "schemaVersion": 2,
  "id": "editor-linear",
  "name": "Editor linear workflow",
  "environment": {
    "variables": {}
  },
  "clientProfiles": [
    {
      "id": "client-1",
      "baseUrl": "http://localhost:8080",
      "timeoutMs": 5000,
      "headers": {}
    }
  ],
  "identities": [],
  "assertions": [],
  "groups": [
    {
      "id": "group-1",
      "clientProfileId": "client-1",
      "identityAssignment": {
        "mode": "shared",
        "identityId": null
      },
      "executor": {
        "kind": "once"
      },
      "lifecycle": {
        "initialize": null,
        "iteration": {
          "workflowId": "workflow-1",
          "inputs": {}
        },
        "cleanup": null,
        "cleanupTimeoutMs": 2000
      }
    }
  ],
  "workflows": [
    {
      "id": "workflow-1",
      "name": "Iteration",
      "inputs": {},
      "outputs": {},
      "nodes": [
        {
          "id": "start",
          "type": "start"
        },
        {
          "id": "http-1",
          "type": "http",
          "name": "HTTP Request",
          "config": {
            "method": "GET",
            "path": "/health",
            "headers": {}
          }
        },
        {
          "id": "http-2",
          "type": "http",
          "name": "HTTP Request",
          "config": {
            "method": "GET",
            "path": "/echo",
            "headers": {}
          }
        },
        {
          "id": "end",
          "type": "end"
        }
      ],
      "edges": [
        {
          "id": "edge-1",
          "from": "start",
          "to": "http-1"
        },
        {
          "id": "edge-2",
          "from": "http-1",
          "to": "http-2"
        },
        {
          "id": "edge-3",
          "from": "http-2",
          "to": "end"
        }
      ],
      "layout": {
        "positions": {
          "start": {
            "x": 80,
            "y": 160
          },
          "end": {
            "x": 860,
            "y": 160
          },
          "http-1": {
            "x": 340,
            "y": 160
          },
          "http-2": {
            "x": 600,
            "y": 160
          }
        }
      }
    }
  ]
}
