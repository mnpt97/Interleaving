<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="interleaving-go"
        Arguments=""
        InstallLocation="C:\Program Files\Interleaving\Interleaving Go">
    </Installer>
    <PackageInformation
        PackageName="Interleaving Go"
        PackageDisplayName="Interleaving Go"
        PublisherName="CN=Interleaving"
        PublisherDisplayName="Interleaving"
        Version="0.1.0.0"
        PackageDescription="Interleaving Go desktop">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.interleaving.go"
                Description="Interleaving Go desktop"
                DisplayName="Interleaving Go"
                ExecutableName="interleaving-go"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Interleaving Go</DisplayName>
            <PublisherDisplayName>Interleaving</PublisherDisplayName>
            <Description>Interleaving Go desktop</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="interleaving-go.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
