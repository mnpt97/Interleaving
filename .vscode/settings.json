{
  "editor.formatOnSave": true,
  "editor.hover.enabled": "on",
  "yaml.schemas": {
    "./schemas/scenario.schema.json": [
      "/scenarios/examples/*.yaml",
      "/scenarios/examples/*.yml",
      "**/*.interl.yaml",
      "**/*.interl.yml"
    ]
  },
  "json.schemas": [
    {
      "fileMatch": [
        "/scenarios/examples/*.json",
        "*.interl.json"
      ],
      "url": "./schemas/scenario.schema.json"
    }
  ],
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  }
}
